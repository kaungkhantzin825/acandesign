# A CAN SOLUTIONS - Security & Performance Settings
# セキュリティとパフォーマンス設定

# Prevent direct access to configuration files
# 設定ファイルへの直接アクセスを防止
<FilesMatch "^(mail-config\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect test file (uncomment after testing)
# テストファイルの保護（テスト後にコメント解除）
# <FilesMatch "^(test-email\.php)$">
#     Order allow,deny
#     Deny from all
# </FilesMatch>

# Enable compression for better performance
# パフォーマンス向上のための圧縮を有効化
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# MIME types — ensure .webp is served as an image. Some older Apache builds send
# application/octet-stream for it, which browsers refuse to render.
# MIMEタイプ設定（.webp を画像として配信）
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
</IfModule>

# Browser caching for static assets
# 静的ファイルのブラウザキャッシュ
# NOTE: assets are cached for a year but filenames are not fingerprinted. If you
# replace an image, give it a new filename — reusing the name serves the stale copy.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Security headers
# セキュリティヘッダー
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable directory browsing
# ディレクトリ一覧表示を無効化
Options -Indexes

# Default charset
# デフォルト文字セット
AddDefaultCharset UTF-8

# ---------------------------------------------------------------------------
# Clean URLs — hide the .php extension
# クリーンURL設定（URLから .php を除外）
#
# Only root-level pages are affected. Requests under /admin/ keep their .php
# URLs, so the admin panel is untouched by these rules.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # (1) /index.php  ->  /
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # (2) /page.php  ->  /page
    # POST requests are never redirected: a 301 on a POST makes some browsers
    # re-issue the request as GET and silently drop the form body.
    RewriteCond %{REQUEST_METHOD} !^POST$
    RewriteCond %{THE_REQUEST} \s/+([^/?]+)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # (3) /page/  ->  /page
    # One canonical form only. A trailing slash would change the browser's base
    # URL and break every relative asset path on the page.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # (4) serve /page from page.php (internal rewrite, no redirect)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^/]+)$ $1.php [L]
</IfModule>
